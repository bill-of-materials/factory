{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:githubActionsVersions",
    ":label(dependencies)",
    ":semanticCommitType(bump)"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images run with `docker run` inside workflow steps (e.g. actionlint)",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "docker run [^\\n]*?(?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "GitHub-hosted runner labels used by the image build matrix",
      "managerFilePatterns": ["/^\\.github/scripts/factory_ci/images\\.py$/"],
      "matchStrings": [
        "\"runner\": \"(?<depName>ubuntu)-(?<currentValue>\\d+\\.\\d+)(?:-arm)?\""
      ],
      "datasourceTemplate": "github-runners"
    },
    {
      "customType": "regex",
      "description": "Dockerfile ARG versions annotated with `# renovate: datasource=... depName=...`",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Dockerfile ARG git revisions annotated with `# renovate: datasource=git-refs depName=<repo> branch=<branch>`",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\s+ARG \\w+_REV=(?<currentDigest>[a-f0-9]{40})"
      ]
    },
    {
      "customType": "regex",
      "description": "README application versions, kept in step with the Dockerfile ARG pins (same dependency, same PR)",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "<!-- renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) -->`(?<currentValue>[^`]+)`"
      ]
    },
    {
      "customType": "regex",
      "description": "README application git revisions: full sha in the comment, short sha displayed",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "<!-- renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+) digest=(?<currentDigest>[a-f0-9]{40}) -->`[a-f0-9]+`"
      ],
      "autoReplaceStringTemplate": "<!-- renovate: datasource={{{datasource}}} depName={{{depName}}} branch={{{currentValue}}} digest={{{newDigest}}} -->`{{{newDigestShort}}}`"
    }
  ],
  "packageRules": [
    {
      "description": "Group all docker image updates",
      "groupName": "container base images",
      "matchDatasources": ["docker"]
    },
    {
      "description": "Pin docker image digests",
      "matchCategories": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Group all GitHub Actions workflow dependencies",
      "groupName": "GitHub Actions dependencies",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Alpine package versions look like 0.35.0-r1",
      "matchDatasources": ["repology"],
      "matchPackageNames": ["/^alpine_/"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$"
    },
    {
      "description": "CI tooling (workflow docker run images, build runner labels) goes with the GitHub Actions dependencies, not the image rebuilds",
      "groupName": "GitHub Actions dependencies",
      "matchFileNames": [".github/**"]
    }
  ]
}
